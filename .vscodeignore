# Tests and their sample transcripts are not needed at runtime.
test/**

# The browser viewer and the Acorn source it falls back to. The extension uses
# Acorn from node_modules instead.
chatview/**
vendor/**

# Editor and VCS noise.
.vscode/**
dev/**
.gitignore
**/*.map

# Repository furniture, not part of the published extension.
.github/**
scripts/**
docs/**
CITATION.cff
CONTRIBUTING.md

# NOTE: media/katex/** is deliberately NOT ignored. The vendored KaTeX build is
# what renders the math, and its LICENSE must ship with it (MIT attribution).
