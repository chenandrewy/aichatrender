{
  "name": "aichatrender",
  "displayName": "AIChatRender",
  "description": "Render Claude Code or Codex CLI session math live from transcripts (read-only, no network).",
  "version": "0.5.0",
  "publisher": "chenandrewy",
  "license": "MIT",
  "icon": "media/icon.png",
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "math",
    "katex",
    "latex",
    "claude code",
    "codex"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.js",
  "scripts": {
    "test": "node --test",
    "chat-example": "node scripts/chat-example.js",
    "export-transcript": "node scripts/export-transcript.js"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onCommand:aichatrender.show",
    "onCommand:aichatrender.followActiveChat",
    "onCommand:aichatrender.browseTurns",
    "onCommand:aichatrender.searchSource"
  ],
  "contributes": {
    "commands": [
      {
        "command": "aichatrender.show",
        "title": "AIChatRender: Show Panel"
      },
      {
        "command": "aichatrender.followActiveChat",
        "title": "AIChatRender: Follow Active Terminal Chat"
      },
      {
        "command": "aichatrender.browseTurns",
        "title": "AIChatRender: Browse Turns and Pick"
      },
      {
        "command": "aichatrender.searchSource",
        "title": "AIChatRender: Search Chat Source"
      }
    ],
    "keybindings": [
      {
        "command": "aichatrender.searchSource",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "activeWebviewPanelId == 'aichatrender'"
      }
    ]
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5"
  }
}
